      "dock": "left",
      "sort_by_path": false,
      "tree_view": true,
    },
    "search": {
      "center_on_match": true,
      "case_sensitive": false,
      "regex": true,
    },
    "lsp": {
      // Give rust-analyzer its own target directory so that we don't have to wait
      // for LSP work that's done by Zed when trying to manually run cargo commands.
      "rust-analyzer": {
        "initialization_options": {
          "cargo": {
            "targetDir": true,
